{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"types": ["jest", "node", "react", "react-native"],
		"paths": {
			"@/*": ["./src/*"],
			"@navigation": ["src/app/navigation/index.ts"],
			"@auth": ["src/features/auth/index.ts"],
			"@tasks": ["src/features/tasks/index.ts"],
			"@profile": ["src/features/profile.ts"],
			"@users": ["src/features/users/index.ts"],
			"@shared": ["src/shared/index.ts"],
			"@/assets/*": ["./assets/*"]
		},

		"typeRoots": ["./node_modules/@types", "./src/types"]
	},
	"include": ["**/*.ts", "**/*.tsx", "src/features/auth/hooks/__mocks__/expo-secure-store.js", "jest-setup.js"]
}
